rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the caller is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if the caller is an admin (has a doc in the Admins collection)
    function isAdmin() {
      return isAuth() && exists(/databases/$(database)/documents/Admins/$(request.auth.uid));
    }

    // ── Admins ──
    match /Admins/{doc} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // ── Banners (public read, admin write) ──
    match /Banners/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Brands (public read, admin write) ──
    match /Brands/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Categories (public read, admin write) ──
    match /Categories/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Subcategories (public read, admin write) ──
    match /Subcategories/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Products (public read, admin write) ──
    match /Products/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // Reviews subcollection
      match /Reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuth();
        allow update, delete: if isAuth();
      }
    }

    // ── Orders ──
    match /Orders/{orderId} {
      allow read, write: if isAuth();
    }

    // ── Coupons (authenticated read, admin write) ──
    match /Coupons/{couponId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // ── Campaigns (admin full access) ──
    match /Campaigns/{campaignId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ── UserCoupons (user reads/writes own, admin full access) ──
    match /UserCoupons/{docId} {
      allow read: if isAuth() && (
        resource.data.UserId == request.auth.uid || isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAuth() && (
        resource.data.UserId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── CouponRedemptions (user creates own, admin reads all) ──
    match /CouponRedemptions/{docId} {
      allow read: if isAuth() && (
        resource.data.UserId == request.auth.uid || isAdmin()
      );
      allow create: if isAuth() && request.resource.data.UserId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── Announcements (authenticated read, admin write) ──
    match /Announcements/{announcementId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // ── Users ──
    match /Users/{userId} {
      // Users can read/write their own doc; admins can read/write any user
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuth() && (request.auth.uid == userId || isAdmin());

      // ── Cart subcollection ──
      match /Cart/{itemId} {
        allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin());
      }

      // ── Wishlist subcollection ──
      match /Wishlist/{itemId} {
        allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin());
      }

      // ── Notifications subcollection ──
      match /Notifications/{notifId} {
        allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin());
      }

      // ── Medicines subcollection (Stock & Reminder module) ──
      match /medicines/{medId} {
        allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin());

        // ── Alarms subcollection ──
        match /alarms/{alarmId} {
          allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin());
        }
      }
    }
  }
}
