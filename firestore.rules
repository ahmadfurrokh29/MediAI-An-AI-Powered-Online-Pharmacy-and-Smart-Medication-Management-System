rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admins (read-only for clients) ──
    match /Admins/{doc} {
      allow read: if request.auth != null;
    }

    // ── Banners (read-only for clients) ──
    match /Banners/{doc} {
      allow read: if true;
    }

    // ── Brands (read-only) ──
    match /Brands/{doc} {
      allow read: if true;
    }

    // ── Categories (read-only) ──
    match /Categories/{doc} {
      allow read: if true;
    }

    // ── Subcategories (read-only) ──
    match /Subcategories/{doc} {
      allow read: if true;
    }

    // ── Products (read-only for clients) ──
    match /Products/{doc} {
      allow read: if true;
    }

    // ── Orders ──
    match /Orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // ── Users ──
    match /Users/{userId} {
      // Users can read/write their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // ── Cart subcollection ──
      match /Cart/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ── Wishlist subcollection ──
      match /Wishlist/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ── Notifications subcollection ──
      match /Notifications/{notifId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ── Medicines subcollection (Stock & Reminder module) ──
      match /medicines/{medId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // ── Alarms subcollection (nested under each medicine) ──
        match /alarms/{alarmId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
  }
}
