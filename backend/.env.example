# ── LLM API Key ───────────────────────────────────────────────────────────────
# Groq (Llama 3.3 70B) — get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── RAG Tuning (optional — defaults are set in rag/config.py) ─────────────────
# RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.50
# RAG_MAX_CONTEXT_CHARS=3000
# RAG_CHUNK_SIZE=600
# RAG_CHUNK_OVERLAP=80

# ── External API timeouts ─────────────────────────────────────────────────────
# API_TIMEOUT=20
